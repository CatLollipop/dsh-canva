{
  "name": "dsh-canva",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Connect Canva through its official MCP server: one-click OAuth with dynamic client registration, native canva_* tools, and eight bundled Canva skills.",
  "license": "MIT",
  "author": "CatLollipop",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "canva",
    "mcp",
    "oauth",
    "design",
    "skills"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "LICENSE",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "oauth-server.js",
    "rpc.js",
    "service.js",
    "skills/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CatLollipop/dsh-canva.git"
  },
  "homepage": "https://github.com/CatLollipop/dsh-canva#readme",
  "bugs": {
    "url": "https://github.com/CatLollipop/dsh-canva/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  }
}
